  const handleAddTag = (e) => {
    if (e.key === 'Enter' && tagInput.trim()) {
      e.preventDefault();
      const newTag = tagInput.trim();
      if (!blogForm.tags.includes(newTag)) {
        setBlogForm(prev => ({ 
          ...prev, 
          tags: [...prev.tags, newTag] 
        }));
      }
      setTagInput('');
