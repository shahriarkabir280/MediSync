{
  "name": "medisync",
  "version": "1.0.0",
  "description": "Backend API for MediSync, a full-stack healthcare management platform for doctors, patients, and diagnostic centers.",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon backend/server.js",
    "start": "node backend/server.js",
    "init-db": "node backend/scripts/init_db.js",
    "seed": "node backend/seed.js",
    "check": "for f in backend/server.js backend/config/*.js backend/routes/*.js backend/controllers/*.js backend/lib/*.js backend/utils/*.js; do node --check \"$f\" || exit 1; done"
  },
  "keywords": [
    "healthcare",
    "express",
    "postgresql",
    "supabase",
    "socket.io",
    "telemedicine"
  ],
  "author": "Md. Shahriar Kabir",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shahriarkabir280/MediSync.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@arcjet/node": "^1.0.0-beta.8",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.93.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.18.0",
    "pg-types": "^4.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
